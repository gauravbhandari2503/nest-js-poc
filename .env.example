# Basic Information
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
FRONTEND_ORIGIN=http://localhost:5173

# Database & Redis
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/book_my_ticket
REDIS_URL=redis://localhost:6379

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
JWT_REFRESH_SECRET=change-me-change-me-change-me-change-me-2
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Mailpit (docker compose)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="Book My Ticket <no-reply@bookmyticket.test>"

# Seed (prisma/seed.ts): the first super admin
SEED_ADMIN_EMAIL=admin@bookmyticket.test
SEED_ADMIN_PASSWORD=change-me-change-me

# Booking rules
BOOKING_HOLD_MINUTES=10
SHOW_CLEANING_BUFFER_MINUTES=15
