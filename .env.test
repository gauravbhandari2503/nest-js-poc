# Loaded by integration/e2e tests and `pnpm prisma:migrate:test`. No secrets: commit-safe.
NODE_ENV=test
PORT=3001
LOG_LEVEL=silent
FRONTEND_ORIGIN=http://localhost:5173

DATABASE_URL=postgresql://postgres:postgres@localhost:5433/book_my_ticket_test
REDIS_URL=redis://localhost:6379/1

JWT_ACCESS_SECRET=test-test-test-test-test-test-test-test
JWT_REFRESH_SECRET=test-test-test-test-test-test-test-test-2
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=1000

SMTP_HOST=localhost
